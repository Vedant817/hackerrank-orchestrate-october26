# Orchestration workspace (task briefs, reviews, run logs) - kept local.
/ghostwatch/

# Secrets - never commit.
.env
.env.*
!.env.example

# Python caches and build output.
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
build/
dist/
